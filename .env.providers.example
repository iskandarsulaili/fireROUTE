# fireROUTE Provider API Keys
# Add your API keys here for providers that require authentication.
# Then run: npx tsx prisma/setup-provider-keys.ts

# ── No-auth providers (no key needed) ──
# wikipedia, wikidata, wikimedia-commons, archive-org, nobel-prize,
# universities-list, french-address-search, microlink-io, callook-info,
# botsarchive, lowy-asia-power-index, open-data-minneapolis, openafrica,
# opensanctions, ume-open-data, university-of-oslo, urban-observatory,
# voidly, onyx-bazaar, modelpartfinder-error-codes

# ── API key providers (register for free keys) ──

# LinkPreview: https://www.linkpreview.net/ (free: 60 req/hr)
LINKPREVIEW_API_KEY=

# Black History Facts: https://www.blackhistoryapi.io/ (free tier)
BLACK_HISTORY_FACTS_API_KEY=

# College ScoreCard: https://collegescorecard.ed.gov/data/ (free: 1,000 req/hr)
# Get key at: https://api.data.gov/signup/
COLLEGESCORECARD_API_KEY=

# GENESIS (German Federal Statistics): https://www-genesis.destatis.de/ (free registration)
# Default guest credentials: GAST / GAST
GENESIS_USERNAME=GAST
GENESIS_PASSWORD=GAST

# Joshua Project: https://api.joshuaproject.net/ (free API key)
JOSHUA_PROJECT_API_KEY=

# Kaggle: https://www.kaggle.com/docs/api (free tier)
KAGGLE_API_KEY=

# Nasdaq Data Link: https://data.nasdaq.com/ (free tier)
NASDAQ_DATA_LINK_API_KEY=

# OpenCorporates: https://opencorporates.com/ (free tier)
OPENCORPORATES_API_TOKEN=

# Recreation Information Database: https://ridb.recreation.gov/ (free API key)
RIDB_API_KEY=

# Socrata: https://dev.socrata.com/ (free app token)
SOCRATA_APP_TOKEN=

# UPC Database: https://upcdatabase.org/ (free tier)
UPC_DATABASE_API_KEY=

# Yelp: https://www.yelp.com/developers (free tier)
YELP_API_KEY=

# Enigma Public: https://developers.enigma.com/ (free tier)
ENIGMA_PUBLIC_API_KEY=
